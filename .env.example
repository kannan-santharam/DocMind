# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Supabase (free tier: https://supabase.com/dashboard) ---
# Settings -> API. The service-role key bypasses RLS: server-side only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Langfuse tracing (https://cloud.langfuse.com) ---
# Optional: leave blank and tracing is a no-op, the app is otherwise unchanged.
# When set, every question becomes a trace named "DocMind", grouped by session,
# with a generation per agent turn and a span per retrieval.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Contact-detail disclosure ---
# Origins allowed to see the phone number and email in the preloaded profile,
# comma-separated. Everywhere else those are stripped from retrieved passages
# before the model or the citation panel ever sees them.
# Unset means withheld everywhere, which is the safe default.
TRUSTED_CONTACT_ORIGINS=https://kannan-ai-dev.vercel.app
