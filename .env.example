# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Supabase (free tier: https://supabase.com/dashboard) ---
# Settings -> API. The service-role key bypasses RLS: server-side only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Langfuse tracing (https://cloud.langfuse.com) ---
# Optional: leave blank and tracing is a no-op, the app is otherwise unchanged.
# When set, every question becomes a trace named "DocMind", grouped by session,
# with a generation per agent turn and a span per retrieval.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Trusted origins ---
# Comma-separated origins that get the full experience: the preloaded documents
# (profile, skills, architecture write-up) and the contact details inside them.
# Reached from anywhere else, the app starts empty and asks for an upload, and
# phone/email are stripped from any passage before the model or the citation
# panel sees them. Unset means that restricted mode everywhere — the safe default.
TRUSTED_ORIGINS=https://kannan-ai-dev.vercel.app,http://localhost:5173

# --- Shared namespace write token ---
# SEED_SESSION_ID is a public constant in the source, so `pnpm seed` must prove
# it is you. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unset means seeding is disabled — writes to the shared namespace fail closed.
SEED_TOKEN=
